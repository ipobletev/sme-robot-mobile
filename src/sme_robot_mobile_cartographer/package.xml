<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sme_robot_mobile_cartographer</name>
  <version>0.0.1</version>
  <description>
    ROS 2 launch scripts and configuration for Google Cartographer SLAM.
  </description>
  <maintainer email="ismael.pbt@gmail.com">Ismael Poblete</maintainer>
  <license>Apache 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>cartographer_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
